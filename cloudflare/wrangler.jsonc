{
  "name": "build2036-revenue-assurance-agent",
  "account_id": "95f96d50618b771a8c58542029828a1a",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["15 2 * * *"]
  },
  // Runtime database is Neon Postgres via secret DATABASE_URL
  // (npx wrangler secret put DATABASE_URL). Do not add a D1 binding.
  // Credential envelope: npx wrangler secret put DATA_SOURCES_KEK (32-byte key, base64). Never commit it.
}
