{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "build2036-revenue-assurance-agent",
  "account_id": "95f96d50618b771a8c58542029828a1a",
  "main": "cloudflare/worker/index.ts",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./cloudflare/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["15 2 * * *"]
  },
  // Always build the SPA into cloudflare/dist, even when CI runs `npx wrangler deploy` from the repo root.
  "build": {
    "command": "npm ci --prefix cloudflare && npm run build --prefix cloudflare"
  },
  "vars": {
    "LLM_PROVIDER": "cloudflare",
    "CLOUDFLARE_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "CF_ACCOUNT_ID": "95f96d50618b771a8c58542029828a1a"
  },
  "previews": {
    "vars": {
      "LLM_PROVIDER": "cloudflare",
      "CLOUDFLARE_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
      "CF_ACCOUNT_ID": "95f96d50618b771a8c58542029828a1a"
    }
  }
}
